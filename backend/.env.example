# Backend configuration (all optional — sensible defaults apply)

# Comma-separated allowed browser origins. Use your frontend URL in production.
CORS_ORIGINS=http://localhost:5173

# Upload guards
MAX_FILES_PER_REQUEST=300
MAX_FILE_MB=15

# Per-IP screening requests per minute
RATE_LIMIT_PER_MINUTE=30

# Documents below this "looks like a resume" confidence are excluded (0..1)
RESUME_CONFIDENCE_MIN=0.35

# Default scoring weights (sum to 100)
W_SEMANTIC=40
W_SKILLS=30
W_RELEVANCE=15
W_EXPERIENCE=15
